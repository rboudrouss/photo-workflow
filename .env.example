# Environnement de DEV (docker-compose.dev.yml). Copier en .env ; ne jamais commiter .env.
# Le serveur se configure dans Coolify (docker-compose.coolify.yml), les workers avec .env.worker.example.

# Dossier des photos sur l'hote (monte en lecture seule dans /photos).
PHOTOS_DIR=./samples

# Backend VLM des workers dev : llama (service llm du compose), anthropic (cle API) ou claude-code (abonnement).
VLM_BACKEND=llama

# Modele GGUF charge par llama-server (surcharge celui du compose).
# LLM_HF_REPO=Qwen/Qwen3-VL-8B-Instruct-GGUF:Q4_K_M
# LLM_THREADS=12

# Claude. Utilise par `photoflow vlm run --backend anthropic` et `photoflow claude-batch` (cle API Console),
# ou par le backend claude-code (jeton d'abonnement cree avec `claude setup-token`).
# ANTHROPIC_API_KEY=sk-ant-api03-...
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=true

# 1 : l'API n'encode pas les requetes de recherche elle-meme et les confie a un worker, comme sur le serveur.
# QUERY_VIA_WORKERS=0
