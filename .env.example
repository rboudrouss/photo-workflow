# Copier en .env et adapter. Ne jamais commiter .env.

# Dossier des photos originales sur l'hote (monte en lecture seule dans /photos).
PHOTOS_DIR=./samples

# Mot de passe Postgres (compose "normal" uniquement).
POSTGRES_PASSWORD=photoflow

# Backend VLM par defaut pour le worker : llama (local) ou anthropic (cloud).
VLM_BACKEND=llama

# Modele GGUF charge par llama-server (surcharge celui du compose).
# LLM_HF_REPO=Qwen/Qwen3-VL-8B-Instruct-GGUF:Q4_K_M
# LLM_THREADS=12

# Claude (cle API Console, facturation a l'usage). Utilise par `photoflow vlm run --backend anthropic`
# et `photoflow claude-batch`. Jamais le token de l'abonnement claude.ai.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ANTHROPIC_FALLBACKS=true

# Grosse machine : modele d'embedding et sa dimension (changer les deux ensemble, puis recreer la base).
# EMBEDDING_MODEL=google/siglip2-so400m-patch16-384
# EMBEDDING_DIM=1152
