# Reverse proxy du serveur de coordination. Variables : DOMAIN, UI_USER, UI_PASSWORD_HASH (compose).
{$DOMAIN} {
	encode zstd gzip

	# Workers distants : pas de mot de passe, un jeton porteur verifie par l'API.
	@worker path /api/worker/*
	handle @worker {
		reverse_proxy api:8000
	}

	# Tout le reste (interface, API, images) est derriere un mot de passe : le fonds contient des photos privees.
	@api path /api/* /media/*
	handle @api {
		basic_auth {
			{$UI_USER} {$UI_PASSWORD_HASH}
		}
		reverse_proxy api:8000
	}
	handle {
		basic_auth {
			{$UI_USER} {$UI_PASSWORD_HASH}
		}
		reverse_proxy web:3000
	}
}
