# Machine perso qui prete sa puissance de calcul : TOUT est facultatif. Sans .env, le worker vise
# https://photoflow.rboud.com et demande a etre approuve sur la page Workers.

# Autre serveur de coordination.
# SERVER_URL=https://photoflow.example.com

# Nom propose a l'approbation (defaut : nom de la machine vu du conteneur).
# WORKER_NAME=pc-remi

# Extracteurs du service worker-ml (vide = aucun, pour ne faire que le VLM avec --profile vlm).
# WORKER_EXTRACTORS=physical,embedding,faces,nudity

# VLM local (profil vlm). Rang deduit du nom (4B -> 4) ; VLM_RANK pour forcer.
# LLM_HF_REPO=Qwen/Qwen3-VL-4B-Instruct-GGUF:Q4_K_M
# LLM_THREADS=8
# VLM_RANK=

# Jeton fixe (sans approbation), cree sur le serveur avec `photoflow workers create <nom>`. Inutile en general.
# WORKER_TOKEN=pfw_...

# cpu | cuda | mps
# DEVICE=cpu
