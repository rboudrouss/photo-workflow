# Worker (docker-compose.worker.yml) : TOUT est facultatif. Copier en .env a cote du compose si besoin.
# Sans .env, le worker vise https://photoflow.rboud.com et demande a etre approuve sur la page Workers.

# Autre serveur de coordination.
# SERVER_URL=https://photoflow.example.com

# Nom propose a l'approbation (defaut : nom du conteneur).
# WORKER_NAME=spark

# Extracteurs du service worker-ml (vide = aucun, pour ne faire que du VLM).
# WORKER_EXTRACTORS=physical,embedding,faces,nudity

# cpu | cuda | mps (cuda par defaut avec docker-compose.worker.gpu.yml).
# DEVICE=cpu

# ---- VLM local (profil vlm : llama.cpp dans Docker ; profil vlm-host : serveur natif sur l'hote)
# Modele, voir docs/models.md. Le rang se deduit du nom (4B -> 4, 32B -> 32) ; VLM_RANK pour forcer.
# LLM_HF_REPO=Qwen/Qwen3-VL-4B-Instruct-GGUF:Q4_K_M
# VLM_RANK=
# Photos analysees en parallele : nombre de workers VLM, et de requetes paralleles cote llama-server.
# VLM_WORKERS=1
# LLM_CTX=8192
# LLM_THREADS=8
# LLM_ARGS=                          # arguments llama-server en plus
# LLM_IMAGE=                         # autre image llama.cpp (ex. construite pour CUDA arm64)
# LLM_BASE_URL=http://host.docker.internal:8080/v1   # profil vlm-host

# ---- VLM Claude (profil claude). Rang 1000 : passe devant tout modele local. L'un OU l'autre :
#  - cle API Console, facturee a l'usage (prioritaire si les deux sont presents) ;
#  - jeton d'abonnement Claude, cree avec `claude setup-token` (compte dans les limites de l'abonnement).
# ANTHROPIC_API_KEY=sk-ant-api03-...
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# Jeton fixe (sans approbation), cree sur le serveur avec `photoflow workers create <nom>`. Inutile en general.
# WORKER_TOKEN=pfw_...
